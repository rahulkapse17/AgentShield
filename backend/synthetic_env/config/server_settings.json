{
  "environment": "production",
  "service_name": "agentshield-core",
  "version": "1.0.0",
  "network": {
    "bind_host": "127.0.0.1",
    "port": 4000,
    "ssl_enabled": true
  },
  "database": {
    "host": "localhost",
    "port": 5432,
    "pool_size": 20,
    "timeout_ms": 5000
  },
  "rate_limits": {
    "max_requests_per_minute": 120,
    "burst": 30
  },
  "features": {
    "audit_hash_chaining": true,
    "strict_fail_closed": true
  }
}

